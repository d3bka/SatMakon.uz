# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=PASTE_NEW_BOT_TOKEN_HERE

# Telegram group ID. Keep the minus sign.
ADMIN_GROUP_CHAT_ID=-1234567890

# Optional: comma-separated Telegram user IDs allowed to use /stats in private chat.
# Example: ADMIN_USER_IDS=123456789,987654321
ADMIN_USER_IDS=

# Optional. The bot still collects phone numbers and sends them to the group
# when DeepSeek is unavailable, but AI answers require a funded key.
DEEPSEEK_API_KEY=

# Optional Google Sheets integration
GOOGLE_CREDENTIALS=
GOOGLE_SHEET_ID=

# Local API settings
ENABLE_LEAD_API=1
LEAD_API_HOST=127.0.0.1
LEAD_API_PORT=8000

# For production, add the exact website origin and use 0.0.0.0 as host.
# Multiple origins are comma-separated.
LEAD_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://satmakon.github.io

# ---------------------------------------------------------------------------
# Docker / VPS production values — uncomment these instead of the block above.
# ---------------------------------------------------------------------------
#
# 0.0.0.0, not 127.0.0.1: the nginx container has to reach this port.
#LEAD_API_HOST=0.0.0.0
#LEAD_API_PORT=8000
#
# uvicorn only honours X-Forwarded-For from IPs listed here (default 127.0.0.1).
# Behind the two proxies the peer is a container IP, so without this every lead
# looks like the same client and the 5-per-10-minutes rate limit in lead_api.py
# becomes a global cap that 429s real users. Safe because port 8000 is never
# published to the host — only the internal nginx can reach it.
#FORWARDED_ALLOW_IPS=*
#
# The site is same-origin in production (nginx proxies /api/), so CORS is not
# used; set it anyway so a direct cross-origin call still works.
#LEAD_ALLOWED_ORIGINS=https://sat-makon.uz,https://www.sat-makon.uz

# Telegram bot + lead API. One process: bot.py polls Telegram on the main thread
# and starts uvicorn (lead_api:app) on a daemon thread — see start_lead_api().
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# public/ is deliberately NOT copied: lead_api.py only mounts StaticFiles when
# ./public exists, so this container stays API-only and nginx owns the website.
COPY bot.py lead_api.py prompts.py sheets.py ./

# data/ is a bind mount in production; create it so an unmounted run still works.
RUN useradd --create-home --uid 1000 app \
    && mkdir -p /app/data \
    && chown -R app:app /app
USER app

EXPOSE 8000

CMD ["python", "bot.py"]
